generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "../node_modules/.prisma/client"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  address               String?
  companyName           String?
  /// JPC sheet viewing paid until this moment (Rs 249 from credits buys 30 days).
  /// Null or past = locked, unless the account is free-role or bought a JPC attach
  /// in the last 30 days.
  jpcViewUntil          DateTime?
  freeTrialUsed         Int                    @default(0)
  gstin                 String?
  isTrialActive         Boolean                @default(false)
  pvcToolSubscriptionActive Boolean          @default(false)
  pvcToolSubscriptionExpiry DateTime?
  panNumber             String?
  phone                 String?
  totalBillsProcessed   Int                    @default(0)
  role                  String                 @default("contractor")
  failedLoginAttempts   Int                    @default(0)
  lastLoginAt           DateTime?
  lastLoginIp           String?
  lastPasswordChange    DateTime?
  lockedUntil           DateTime?
  passwordExpiresAt     DateTime?
  logoPath              String?
  reportFooterText      String?
  reportHeaderColor     String?
  reportHeaderText      String?
  showLogoInReports     Boolean                @default(true)
  customProcessingFee   Float?
  isFreeAccount         Boolean                @default(false)
  department            String?
  designation           String?
  division              String?
  divisionName          String?
  headquartersStation   String?
  isCurrentPosting      Boolean                @default(true)
  officeLocation        String?
  postingEndDate        DateTime?
  postingStartDate      DateTime?
  railwayZone           String?
  railwayZoneName       String?
  section               String?
  contractLimitOverride Int?
  resetToken            String?
  resetTokenExpiry      DateTime?
  referralCode          String?                @unique
  accounts              Account[]
  sessions              Session[]
  billApprovalHistory   BillApprovalHistory[]
  billTransactions      BillTransaction[]
  pvcChecks             PvcCheck[]
  billApprovals         Bill[]                 @relation("BillApprovals")
  billsPassedByAccounts Bill[]                 @relation("BillAccountsPassed")
  contracts             Contract[]
  creditTransactions    CreditTransaction[]
  customerAccount       CustomerAccount?
  invoices              Invoice[]
  reportTemplates       ReportTemplate[]
  billAccess            UserBillAccess[]
  contractAccess        UserContractAccess[]
  pageAccess            UserPageAccess[]
  labourIndexDocuments  LabourIndexDocument[]
  gstInvoices           GstInvoice[]
  whatsappConversations  WhatsAppConversation[]
  telegramConversations  TelegramConversation[]
  whatsappLogs          WhatsAppLog[]
  apiKeys               ApiKey[]
  referralsMade         Referral[]             @relation("ReferralReferrer")
  referralReceived      Referral?              @relation("ReferralReferred")
  reviewRewardSubmission ReviewRewardSubmission?

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([referralCode])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PhoneOtp {
  id          String   @id @default(cuid())
  phone       String
  otp         String
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([phone, otp])
  @@index([phone, verified])
  @@map("phone_otps")
}

model ClassificationGroup {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  description        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subClassifications SubClassification[]

  @@map("classification_groups")
}

model SubClassification {
  id                        String                    @id @default(cuid())
  code                      String                    @unique
  name                      String
  description               String?
  groupId                   String
  fixed                     Float                     @default(15)
  labour                    Float                     @default(0)
  steel                     Float                     @default(0)
  cement                    Float                     @default(0)
  plantMachinery            Float                     @default(0)
  fuel                      Float                     @default(0)
  otherMaterials            Float                     @default(0)
  explosives                Float                     @default(0)
  isActive                  Boolean                   @default(true)
  isDefault                 Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  billClassificationEntries BillClassificationEntry[] @relation("SubClassificationEntries")
  group                     ClassificationGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("sub_classifications")
}

model Classification {
  id                        String                    @id @default(cuid())
  code                      String                    @unique
  name                      String
  description               String?
  fixed                     Float                     @default(15)
  labour                    Float                     @default(20)
  steel                     Float                     @default(0)
  cement                    Float                     @default(0)
  plantMachinery            Float                     @default(20)
  fuel                      Float                     @default(15)
  otherMaterials            Float                     @default(20)
  explosives                Float                     @default(10)
  isActive                  Boolean                   @default(true)
  isDefault                 Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  subClassifications        Json?                     @default("[]")
  billClassificationEntries BillClassificationEntry[] @relation("LegacyClassificationEntries")
  bills                     Bill[]

  @@map("classifications")
}

model Contract {
  id                           String               @id @default(cuid())
  agreementNo                  String               @unique
  loaNo                        String?
  loaDate                      DateTime?
  contractorName               String
  contractorPhone              String?
  workDescription              String
  workClassification           String?
  dateOfOpening                DateTime
  baseMonth                    DateTime
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  userId                       String?
  currentCompletionDate        DateTime?
  extensionGrantedDate         DateTime?
  extensionReason              String?
  extensionType                String?
  isExtended                   Boolean              @default(false)
  originalCompletionDate       DateTime?
  completionPeriodMonths       Int?
  contractValue                Float?
  /// How this contract was created: "manual", "pdf" (filled from an uploaded
  /// agreement), or "telegram". Null for contracts created before the column existed.
  createdVia                   String?
  /// Which General Conditions of Contract price this: "pre-2022" or "gcc-2022".
  /// Null means nobody has decided, and the tender date is used to work it out.
  /// Only ever set by a human, because around April 2022 the date cannot settle it.
  ///
  /// NOT named gccVersion: the live database already has a column of that name holding
  /// a Postgres ENUM (values like GCC_APR_2022) that schema.prisma never declared.
  /// Declaring a String field over it broke every contract query with a type conversion
  /// error. This is a separate column and leaves that one untouched.
  pvcClauseVersion             String?
  /// For pre-2022 contracts only: which of Clause 46A.6's six work types applies.
  /// The tender fixes one for the whole work — there are no sub-classes in that
  /// clause. Null means the work description is used to propose one.
  pre2022WorkType              String?
  hasRailwaySuppliedMaterials  Boolean              @default(false)
  pvcApplicable                Boolean              @default(true)
  pvcEligibilityNote           String?
  railwaySuppliedMaterialsNote String?
  tenderAdvertisedValue        Float?
  coveringLetterDesignation    String?
  /// Rebate % is agreed once for the whole agreement (not per schedule).
  /// Escalation % and bid rate % are per-schedule and live in `schedules`.
  rebatePercentage             Float?
  /// Which diesel price this agreement's PVC uses: "four_city_avg" (PPAC average of
  /// Delhi/Kolkata/Mumbai/Chennai, per GCC-2022 Cl.46A.7) or "zone_city" (the zone's
  /// own city). Kept per contract because railways differ in practice: SWR's letter
  /// dated 23.01.2026 directs the PPAC average, while Sr.DFM/MDU (Southern Railway)
  /// returned a proposal demanding the Chennai rate. Older agreements may also sit
  /// under a pre-2022 GCC. Bills default to this, and it must never be hardcoded.
  fuelPriceType                String?              @default("four_city_avg")
  schedules                    Json?                @default("[]")
  bills                        Bill[]
  extensions                   ContractExtension[]
  user                         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pvcCalculations              PvcCalculation[]
  pvcChecks                    PvcCheck[]
  userAccess                   UserContractAccess[]

  @@index([userId])
  @@index([agreementNo])
  @@index([dateOfOpening])
  @@index([createdAt])
  @@map("contracts")
}

// Tracks which normalized agreement numbers have already consumed a free trial
// globally — prevents multi-account trial abuse on the same contract.
model TrialClaimedAgreement {
  id                   String   @id @default(cuid())
  normalizedAgreementNo String  @unique
  claimedByUserId      String
  claimedAt            DateTime @default(now())

  @@index([normalizedAgreementNo])
  @@map("trial_claimed_agreements")
}

model ContractExtension {
  id                     String    @id @default(cuid())
  contractId             String
  extensionType          String
  extensionReason        String?
  originalCompletionDate DateTime
  extendedCompletionDate DateTime
  extensionDuration      Int
  isPvcRestricted        Boolean   @default(false)
  pvcRestrictionDate     DateTime?
  approvedBy             String?
  approvalDate           DateTime  @default(now())
  orderNumber            String?
  liquidatedDamagesRate  Float?
  isLiquidatedDamages    Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  extensionSubcategory   String?
  contract               Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_extensions")
}

model ExtensionSubcategory {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String   @default("")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("extension_subcategories")
}

model PriceIndex {
  id            String              @id @default(cuid())
  name          String              @unique
  baseValue     Float
  description   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  monthlyValues MonthlyIndexValue[]

  @@map("price_indices")
}

/// A published schedule of rates — CPWD DSR 2021 and 2023, Railways USSOR 2021 —
/// loaded from the official books by /api/admin/dsr-items/import. A bill cites a code
/// and prints only what distinguishes a sub-item, so the wording of the work itself
/// lives here and nowhere else.
///
/// Keyed by edition as well as code: the same number means different work in different
/// editions, so a code without its edition is ambiguous.
model DsrItem {
  edition     String
  code        String
  subHead     String
  subHeadName String
  description String
  unit        String   @default("")
  rate        Float?
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([edition, code])
  @@index([code])
  @@map("dsr_items")
}

model DsrCementCoefficient {
  id                    String   @id @default(cuid())
  dsrCode               String   @unique
  description           String
  workUnit              String
  cementQuantityPerUnit Float
  cementUnit            String   @default("MT")
  source                String   @default("DSR 2021 Analysis of Rates")
  notes                 String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([dsrCode])
  @@index([isActive])
  @@map("dsr_cement_coefficients")
}

model MonthlyIndexValue {
  id            String     @id @default(cuid())
  priceIndexId  String
  month         DateTime
  value         Float
  source        String?
  isProvisional Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  priceIndex    PriceIndex @relation(fields: [priceIndexId], references: [id], onDelete: Cascade)

  @@unique([priceIndexId, month])
  @@index([month])
  @@index([priceIndexId, month])
  @@map("monthly_index_values")
}

// JPC Steel Item Records - stores individual JPC items with fortnightly prices
model JpcSteelItem {
  id           String   @id @default(cuid())
  itemCode     String // e.g., "tmt_10mm", "isa_75x75x6"
  itemName     String // e.g., "TMT 10 MM", "ANGLES 75X75X6 MM"
  category     String // TMT, ANGLE, CHANNEL, JOIST, PLATE, HR_COIL, CR_COIL, ROUND, WIRE_ROD, OTHER
  indexMapping String? // Which steel index this maps to: TMT, ANGLE_CHANNEL, PLATES, OTHER_SECTIONS
  month        DateTime
  city         String   @default("Chennai")
  f1           Float? // First fortnight price
  f2           Float? // Second fortnight price
  average      Float? // Calculated (f1+f2)/2
  source       String? // e.g., "JPC Bulletin May 2025"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([itemCode, month, city])
  @@index([month])
  @@index([category])
  @@index([indexMapping])
  @@map("jpc_steel_items")
}

// Daily fuel prices from PPAC (Petroleum Planning & Analysis Cell)
model DailyFuelPrice {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  delhi     Float // Diesel price in Delhi (Rs/Litre)
  mumbai    Float // Diesel price in Mumbai (Rs/Litre)
  chennai   Float // Diesel price in Chennai (Rs/Litre)
  kolkata   Float // Diesel price in Kolkata (Rs/Litre)
  source    String? // e.g., "PPAC"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@map("daily_fuel_prices")
}

enum ComponentType {
  LABOUR
  PLANT_MACHINERY_SPARES
  MPNG_FUEL
  OTHER_MATERIALS
  CEMENT
  TMT_BARS
  ANGLE_CHANNEL
  PLATES
  OTHER_SECTIONS
}

model LabourIndexDocument {
  id               String        @id @default(cuid())
  componentType    ComponentType
  year             Int
  months           Int[]
  fileName         String
  cloudStoragePath String
  uploadedBy       String
  isProvisional    Boolean       @default(true)
  remarks          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([componentType, year])
  @@index([year])
  @@index([isProvisional])
  @@map("labour_index_documents")
}

model Bill {
  id                       String                    @id @default(cuid())
  contractId               String
  billNo                   String
  billAmount               Float
  dateOfMeasurement        DateTime
  quarter                  String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  isChargeable             Boolean                   @default(true)
  processingFee            Float                     @default(1000)
  /// When the charge for attaching the JPC steel sheets to this bill's report was
  /// paid. Null = not paid; reports then carry every annex except the JPC pages.
  jpcDocsPurchasedAt       DateTime?
  cementAmount             Float?                    @default(0)
  steelAmount              Float?                    @default(0)
  selectedSteelComponent   String?                   @default("Steel TMT Bars")
  steelTypes               Json?                     @default("[]") // Array of steel types for classification-based calculations: ["TMT", "ANGLE_CHANNEL", "PLATES", "OTHER_SECTIONS"]
  isFinalPvc               Boolean                   @default(false)
  editCount                Int                       @default(0) // tracks how many times bill has been edited
  pvcNumber                String?
  zone                     String?
  fuelPriceType            String?                   @default("four_city_avg") // "four_city_avg" or "zone_city"
  dateOfCompletion         DateTime?
  nonScheduleItems         Json?                     @default("[]")
  steelAngleChannelAmount  Float?                    @default(0)
  steelOtherSectionsAmount Float?                    @default(0)
  steelPlatesAmount        Float?                    @default(0)
  steelTmtBarsAmount       Float?                    @default(0)
  grossBillAmount          Float
  subClassifications       Json?                     @default("[]")
  workClassificationId     String?
  batchId                  String?
  batchName                String?
  approvalComments         String?
  approvedAt               DateTime?
  approvedBy               String?
  rejectionReason          String?
  /// draft -> submitted -> approved (executive) -> passed_for_payment (accounts).
  /// rejected and revision_requested can be set at either stage.
  status                   String                    @default("draft")
  submittedAt              DateTime?
  /// The accounts/audit stage, which follows the executive approval. A PVC proposal is
  /// approved by the engineering side and then vetted by accounts before payment, and
  /// the two are separate people answering for separate things — so the bill records
  /// both, not one "approved" flag.
  passedAt                 DateTime?
  passedBy                 String?
  passedComments           String?
  /// Set when accounts send the proposal back, so the contractor sees what to fix.
  accountsReturnReason     String?
  /// Which checks the accounts office ticked when passing it, and which they did not.
  /// "Passed for payment" on its own says nothing about what was looked at; this is
  /// what answers a query months later. See lib/accounts-checklist.ts.
  accountsVerification     Json?
  hasBeenEditedOnce        Boolean                   @default(false)
  lastEditedBy             String?
  lastEditedAt             DateTime?
  /// Value of materials supplied by the Railway (free or at fixed rate) included in
  /// this bill. GCC-2022 Cl.46A defines W as the gross value of work done EXCLUDING
  /// "cost of materials supplied by Railway either free or at fixed rate", so this is
  /// deducted from the PVC base. Null/0 = nothing supplied by the Railway.
  /// How this bill was created: "manual", "pdf" (read from an uploaded bill PDF),
  /// or "telegram". Null for bills created before the column existed.
  createdVia                   String?
  railwaySuppliedMaterialValue Float?                @default(0)
  approvalHistory          BillApprovalHistory[]
  classificationEntries    BillClassificationEntry[]
  billTransaction          BillTransaction?
  approvedByUser           User?                     @relation("BillApprovals", fields: [approvedBy], references: [id])
  passedByUser             User?                     @relation("BillAccountsPassed", fields: [passedBy], references: [id])
  contract                 Contract                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workClassification       Classification?           @relation(fields: [workClassificationId], references: [id])
  pvcCalculation           PvcCalculation?
  shortfallAudit           ShortfallAudit?
  userAccess               UserBillAccess[]
  whatsappLogs             WhatsAppLog[]

  @@index([contractId])
  @@index([billNo])
  @@index([dateOfMeasurement])
  @@index([quarter])
  @@index([createdAt])
  @@index([isChargeable])
  @@index([batchId])
  @@index([status])
  @@index([approvedBy])
  // Composite indexes for common query patterns
  @@index([contractId, dateOfMeasurement]) // bills filtered by contract ordered by date
  @@index([contractId, createdAt])         // bills list per contract paginated by creation
  @@index([quarter, status])               // approval workflow queries
  @@map("bills")
}

model BillClassificationEntry {
  id                 String  @id @default(cuid())
  billId             String
  classificationId   String?
  subClassifications Json    @default("[]")
  amount             Float
  description        String?
  steelTypes         Json?   @default("[]") // Array of steel types: ["TMT", "ANGLE_CHANNEL", "PLATES", "OTHER_SECTIONS"]
  scheduleItem       String?
  itemNumber         String?  // Item number from bill (e.g., "1130 10 (G)")
  quantity           Float?   // Qty executed since last bill
  agreementRate      Float?   // Agreement Rate in Rs.
  itemRows           Json?    // Array of {itemNumber, quantity, agreementRate} for multi-item entries
  classificationJustification String? // Reasoning for why this classification was chosen for the item

  // Per-entry PVC breakdown (calculated during bill processing)
  labourPvc         Float? @default(0)
  plantMachineryPvc Float? @default(0)
  fuelPowerPvc      Float? @default(0)
  otherMaterialsPvc Float? @default(0)
  cementPvc         Float? @default(0)
  steelPvc          Float? @default(0)
  explosivesPvc     Float? @default(0)
  totalPvc          Float? @default(0)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  subClassificationId String?
  bill                Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  classification      Classification?    @relation("LegacyClassificationEntries", fields: [classificationId], references: [id])
  subClassification   SubClassification? @relation("SubClassificationEntries", fields: [subClassificationId], references: [id])

  @@index([billId])
  @@index([classificationId])
  @@index([subClassificationId])
  @@map("bill_classification_entries")
}

// Railway's own PVC figures for a bill, entered by the contractor so the app can
// compute the shortfall between what Railway paid/certified and the correct
// GCC 46A entitlement it computed. One optional record per bill.
model ShortfallAudit {
  id                    String   @id @default(cuid())
  billId                String   @unique
  railwayTotal          Float    @default(0) // total PVC Railway paid/certified
  // Optional component-wise figures Railway paid (leave 0/null if only the total is known)
  railwayLabour         Float?
  railwayPlantMachinery Float?
  railwayFuelPower      Float?
  railwayCement         Float?
  railwaySteel          Float?
  railwayOtherMaterials Float?
  railwayExplosives     Float?
  railwayReference      String? // Railway PVC certificate / payment-advice reference
  remarks               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  bill                  Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("shortfall_audits")
}

model PvcCalculation {
  id                             String    @id @default(cuid())
  contractId                     String
  billId                         String    @unique
  labourPvc                      Float     @default(0)
  plantMachineryPvc              Float     @default(0)
  fuelPowerPvc                   Float     @default(0)
  otherMaterialsPvc              Float     @default(0)
  cementPvc                      Float     @default(0)
  explosivesPvc                  Float     @default(0)
  steelPvc                       Float     @default(0)
  totalPvc                       Float
  previousPvcTotal               Float     @default(0)
  cumulativePvc                  Float
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  dedicatedCementPvc             Float     @default(0)
  dedicatedSteelPvc              Float     @default(0)
  cappedCementIndex              Float?    @default(0)
  cappedExplosivesIndex          Float?    @default(0)
  cappedFuelIndex                Float?    @default(0)
  cappedLabourIndex              Float?    @default(0)
  cappedMaterialsIndex           Float?    @default(0)
  cappedPlantIndex               Float?    @default(0)
  cappedSteelIndex               Float?    @default(0)
  extensionType                  String?
  indexCapDate                   DateTime?
  isExtensionPeriod              Boolean   @default(false)
  isIndexCapped                  Boolean   @default(false)
  originalPvcAmount              Float?    @default(0)
  pvcRestrictionReason           String?
  pvcSavingsDueToRestriction     Float?    @default(0)
  restrictedPvcAmount            Float?    @default(0)
  dedicatedSteelAngleChannelPvc  Float     @default(0)
  dedicatedSteelOtherSectionsPvc Float     @default(0)
  dedicatedSteelPlatesPvc        Float     @default(0)
  dedicatedSteelTmtBarsPvc       Float     @default(0)
  indexL_Cement                  Float?    @default(0)
  indexL_Explosives              Float?    @default(0)
  indexL_Fuel                    Float?    @default(0)
  indexL_Labour                  Float?    @default(0)
  indexL_Materials               Float?    @default(0)
  indexL_Plant                   Float?    @default(0)
  indexL_Steel                   Float?    @default(0)
  // True when this saved PVC was computed while one or more quarter months were
  // provisional or borrowed. Stays true (sticky) after the real index is published,
  // so the bill can still offer a "Regenerate" action until it is recalculated.
  usedProvisionalIndices         Boolean   @default(false)
  bill                           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  contract                       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("pvc_calculations")
}

model CustomerAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  status            String   @default("active")
  billingEmail      String?
  paymentMethod     String?
  currentTier       String   @default("standard")
  monthlyBillCount  Int      @default(0)
  creditBalance     Float    @default(0)
  outstandingAmount Float    @default(0)
  lastMonthBills    Int      @default(0)
  currentMonthBills Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_accounts")
}

model BillTransaction {
  id             String       @id @default(cuid())
  userId         String
  billId         String       @unique
  amount         Float
  originalAmount Float        @default(1000)
  discount       Float        @default(0)
  discountType   String?
  status         String       @default("pending")
  isFree         Boolean      @default(false)
  paymentMethod  String?
  transactionRef String?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  metadata       Json?
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
