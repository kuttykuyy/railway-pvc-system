  userId        String // User who triggered the message
  phoneNumber   String // Recipient phone number
  recipientName String? // Recipient name
  template      String // Template name used
  parameters    Json // Template parameters sent
  status        String    @default("pending") // pending, sent, delivered, read, failed
  messageId     String? // WhatsApp message ID from provider
  errorMessage  String? // Error message if failed
  pdfUrl        String? // PDF URL if attached
  sentAt        DateTime  @default(now())
  deliveredAt   DateTime?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bill          Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)
  user          User      @relation(fields: [userId], references: [id])

  @@index([billId])
  @@index([userId])
  @@index([phoneNumber])
  @@index([status])
  @@index([sentAt])
  @@index([template])
  @@map("whatsapp_logs")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String // Friendly name for the API key
  key         String    @unique // The actual API key (hashed)
  userId      String // User who owns this API key
  description String? // Optional description of what this key is for
  scopes      Json      @default("[]") // Array of allowed scopes/endpoints
  isActive    Boolean   @default(true) // Can be deactivated without deletion
  expiresAt   DateTime? // Optional expiration date
  lastUsedAt  DateTime? // Track last usage
  usageCount  Int       @default(0) // Track number of API calls
  rateLimit   Int       @default(100) // Requests per minute limit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

/// Distributed, atomic rate-limit counters shared across serverless instances.
/// One row per limiter key (e.g. "login:user@x.com", "otp:ip"). The window is
/// reset atomically via an ON CONFLICT upsert in lib/rate-limit-db.ts.
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
  @@map("rate_limits")
}

/// One row per call to the AI provider (Abacus RouteLLM), so the admin can see
/// how much AI has been consumed. Token counts come from the provider response
/// `usage`. Abacus exposes no balance API, so remaining credit is NOT stored —
/// only consumption and whether the call succeeded (failures record why, e.g.
/// "out_of_credit"). Written fire-and-forget from lib/ai-usage.ts.
model AiUsageLog {
  id               String   @id @default(cuid())
  operation        String // e.g. "bill-extraction"
  model            String   @default("route-llm")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  success          Boolean  @default(true)
  errorType        String? // e.g. "out_of_credit"
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([success])
  @@map("ai_usage_logs")
}
