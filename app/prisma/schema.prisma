  conversationData Json      @default("{}") // Stores temporary data during conversation
  lastMessageAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expiresAt        DateTime? // Conversation expires after inactivity
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([phoneNumber])
  @@index([userId])
  @@index([currentStep])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
