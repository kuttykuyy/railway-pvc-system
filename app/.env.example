
# Supabase Database
# Use the Supabase transaction pooler URL for app runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use the Supabase direct connection URL for Prisma commands.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
# REQUIRED - no fallback is permitted. Generate a strong random value (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET="your-secret-key-here"

# File Storage (S3-compatible: AWS S3, Supabase Storage, Cloudflare R2, MinIO, etc.)
# Required for uploading files larger than ~4MB on Vercel serverless.
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="ap-south-1"
# Primary bucket name variable. Aliases: S3_BUCKET_NAME, SUPABASE_STORAGE_BUCKET
AWS_BUCKET_NAME="your-bucket-name"
# Optional: custom S3 endpoint for Supabase/R2/MinIO (e.g. https://PROJECT_REF.supabase.co/storage/v1/s3)
S3_ENDPOINT_URL=""
# Optional: set to 'false' if your provider requires virtual-hosted-style URLs
S3_FORCE_PATH_STYLE="true"

# Razorpay Configuration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Billing Configuration
BILLING_BASE_PRICE_PER_BILL=1000
BILLING_CURRENCY=INR
BILLING_FREE_TRIAL_BILLS=1

# PWA Push Notifications (VAPID Keys) - Optional
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Slack Configuration
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
SLACK_CHANNEL="#pvc-alerts"
SLACK_USERNAME="Railway PVC Bot"

# Razorpay Webhook (Production)
RAZORPAY_WEBHOOK_SECRET="your-actual-webhook-secret"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# REQUIRED for webhook signature verification. Generate a strong random secret.
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# External API CORS
# Comma-separated list of origins allowed to call /api/external/* endpoints.
# Leave empty to disallow cross-origin browser requests.
ALLOWED_EXTERNAL_ORIGINS="https://primerp.in"

# Data Encryption
# REQUIRED - no fallback is permitted. Must be a 32-byte key for AES-256-GCM.
ENCRYPTION_KEY="your-32-byte-encryption-key"

# Admin seed (only used when running `npx prisma db seed`)
ADMIN_SEED_EMAIL="admin@railway.gov.in"
ADMIN_SEED_PASSWORD="your-strong-admin-password"

# PDF-to-Markdown service
# REQUIRED by both the Next.js extraction route and the internal Python function.
# Generate with: openssl rand -base64 32
MARKITDOWN_INTERNAL_SECRET="your-strong-internal-secret"
# Optional full endpoint URL. Leave empty to use the current app origin.
MARKITDOWN_SERVICE_URL=""

# System Monitoring
ENABLE_SLACK_NOTIFICATIONS="true"
ENABLE_ERROR_TRACKING="true"
ADMIN_ALERTS_ENABLED="true"

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="+14155238886"  # Twilio Sandbox number (for testing)
